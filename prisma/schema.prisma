generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id             String       @id @default(uuid())
  username       String       @unique
  displayName    String?
  bio            String?
  trustScore     Float        @default(80)
  followers      Int          @default(0)
  engagementRate Float        @default(0)
  isAiCreator    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  twin           CreatorTwin?
  videos         Video[]

  @@index([trustScore])
  @@index([isAiCreator])
}

model CreatorTwin {
  id              String   @id @default(uuid())
  creatorId       String   @unique
  tone            String
  styleProfile    Json
  audienceProfile Json
  preferredTopics Json
  knowledgeGraph  Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Avatar {
  id        String   @id @default(uuid())
  name      String
  category  String
  gender    String?
  ageGroup  String?
  voiceId   String
  modelUrl  String?
  language  String   @default("en")
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]

  @@index([category])
  @@index([language])
  @@index([region])
}

model Trend {
  id         String   @id @default(uuid())
  topic      String
  region     String?
  country    String?
  category   String
  score      Float
  growthRate Float
  source     String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  scripts    Script[]
  scriptProviderLog ScriptProviderLog[] // Added

  @@index([category])
  @@index([region])
  @@index([country])
  @@index([score])
}

model Script {
  id           String   @id @default(uuid())
  trendId      String?
  title        String
  hook         String
  body         String
  cta          String?
  language     String   @default("en")
  durationHint Int      @default(45)
  qualityScore Float    @default(0)
  factScore    Float    @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trend        Trend?   @relation(fields: [trendId], references: [id])
  videos       Video[]
  providerLogs ScriptProviderLog[] //Added

  @@index([language])
  @@index([qualityScore])
  @@index([factScore])
}

model Video {
  id              String          @id @default(uuid())
  creatorId       String?
  avatarId        String?
  scriptId        String?
  title           String
  category        String
  videoUrl        String?
  thumbnailUrl    String?
  durationSeconds Int?
  status          VideoStatus     @default(DRAFT)
  region          String?
  country         String?
  language        String          @default("en")
  isSeedContent   Boolean         @default(true)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  feedEvents      FeedEvent[]
  moderationLogs  ModerationLog[]
  avatar          Avatar?         @relation(fields: [avatarId], references: [id])
  creator         Creator?        @relation(fields: [creatorId], references: [id])
  script          Script?         @relation(fields: [scriptId], references: [id])
  score           VideoScore?
  renderMetadata  RenderMetadata? //Added
  providerJobs    ProviderJobLog[] //Added

  @@index([status])
  @@index([category])
  @@index([region])
  @@index([country])
  @@index([language])
  @@index([isSeedContent])
  @@index([publishedAt])
}

model VideoScore {
  id               String   @id @default(uuid())
  videoId          String   @unique
  viralProbability Float
  engagementScore  Float
  watchTimeScore   Float
  shareScore       Float
  commentScore     Float
  qualityScore     Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([viralProbability])
  @@index([engagementScore])
  @@index([qualityScore])
}

model ModerationLog {
  id         String           @id @default(uuid())
  videoId    String
  action     ModerationAction
  reason     String?
  score      Float
  metadata   Json?
  reviewedBy String?
  createdAt  DateTime         @default(now())
  providerName String?          //  Added
  providerAction String?          //  Added
  providerMetadata Json?            //  Added
  fallbackUsed  Boolean          @default(false) // Added
  video       Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([score])
  @@index([createdAt])
}

model FeedEvent {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  action    String
  watchMs   Int?
  region    String?
  metadata  Json?
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([action])
  @@index([createdAt])
}

model AdCampaign {
  id         String           @id @default(uuid())
  advertiser String
  title      String
  budget     Float
  spent      Float            @default(0)
  targeting  Json
  status     AdCampaignStatus @default(DRAFT)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model RenderMetadata {
 id               String @id @default(uuid())
 videoId          String @unique
 ttsProvider      String?
 avatarProvider   String?
 renderProvider   String?
 audioUrl         String?
 avatarVideoUrl   String?
 composedVideoUrl  String?
 thumbnailUrl     String?
 durationSeconds  Int?
 fallbackUsed     Boolean @default(false)
 failureReason    String?
 metadata         Json?
 createdAt        DateTime @default(now())
 updatedAt        DateTime @updatedAt

 video            Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

 @@index([ttsProvider])
 @@index([avatarProvider])
 @@index([renderProvider])
 @@index([fallbackUsed])
}

model ProviderJobLog {
 id               String @id @default(uuid())
 videoId          String?
 jobType          ProviderJobType
 providerName     String
 status           ProviderJobStatus
 requestPayload   Json?
 responsePayload  Json?
 errorMessage     String?
 fallbackUsed     Boolean @default(false)
 startedAt        DateTime @default(now())
 completedAt      DateTime?

 video            Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

 @@index([videoId])
 @@index([jobType])
 @@index([providerName])
 @@index([status])
 @@index([fallbackUsed])
 @@index([startedAt])
}

model ScriptProviderLog {
 id               String @id @default(uuid())
 scriptId         String?
 trendId          String?
 providerName     String
 status           ProviderJobStatus
 requestPayload   Json?
 responsePayload  Json?
 errorMessage     String?
 fallbackUsed     Boolean @default(false)
 startedAt        DateTime @default(now())
 completedAt      DateTime?
 script           Script? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
 trend            Trend? @relation(fields: [trendId], references: [id], onDelete: SetNull)
 
 @@index([scriptId])
 @@index([trendId])
 @@index([providerName])
 @@index([status])
 @@index([fallbackUsed])
 @@index([startedAt])
}

model UserInterestProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  categoryScores Json
  regionScores   Json?
  lastUpdatedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}

enum VideoStatus {
  DRAFT
  SCRIPTED
  RENDERING
  MODERATION
  APPROVED
  PUBLISHED
  REJECTED
  FAILED
}

enum ModerationAction {
  ALLOW
  LIMIT
  REVIEW
  BLOCK
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProviderJobType {
 LLM_SCRIPT
 TTS
 AVATAR_VIDEO
 VIDEO_COMPOSITE
 MODERATION
}
enum ProviderJobStatus {
 PENDING
 RUNNING
 SUCCESS
 FAILED
 FALLBACK_USED
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_ADMIN
  MODERATOR
  VIEWER
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([role])
}

model EventProcessingLog {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  topic          String
  status         String
  attempts       Int      @default(0)
  errorMessage   String?
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([topic])
  @@index([status])
  @@index([createdAt])
}
// ============================================================
// Recovery Governance Models (Batch 54)
// ============================================================

enum RecoveryRepositoryStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  CERTIFIED
  BLOCKED
}

enum RecoveryBatchStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  NOT_APPLICABLE
}

enum EvidenceCategory {
  TEST
  API
  LOG
  SCREENSHOT
  METRICS
  BACKUP
  CERT
  DEPLOY
  SECURITY
  OTHER
}

enum GovernanceSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum GovernanceItemStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ACCEPTED
  REJECTED
}

enum CertificationDecision {
  PENDING
  APPROVED
  REJECTED
}

model RecoveryRepository {
  id                String                     @id @default(uuid())
  code              String                     @unique
  name              String
  owner             String
  repositoryPath    String
  status            RecoveryRepositoryStatus   @default(NOT_STARTED)
  alignmentScore    Int                        @default(0)
  evidenceSubmitted Boolean                    @default(false)
  certifiedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  batches           RecoveryBatchCompletion[]
  evidence          RecoveryEvidence[]
  blockers          RecoveryBlocker[]
  risks             RecoveryRisk[]
  certifications    RecoveryCertification[]

  @@index([status])
  @@index([alignmentScore])
}

model RecoveryBatchCompletion {
  id             String               @id @default(uuid())
  repositoryId   String
  batchNumber    Int
  title          String
  status         RecoveryBatchStatus  @default(NOT_STARTED)
  evidenceIds    String[]             @default([])
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  repository     RecoveryRepository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, batchNumber])
  @@index([batchNumber])
  @@index([status])
}

model RecoveryEvidence {
  id             String            @id @default(uuid())
  evidenceCode   String            @unique
  repositoryId   String
  category       EvidenceCategory
  title          String
  description    String?
  storageUrl     String?
  submittedBy    String?
  reviewedBy     String?
  reviewedAt     DateTime?
  accepted       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  repository     RecoveryRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([category])
  @@index([accepted])
}

model RecoveryBlocker {
  id             String               @id @default(uuid())
  blockerCode    String               @unique
  repositoryId   String
  title          String
  description    String
  severity       GovernanceSeverity
  status         GovernanceItemStatus @default(OPEN)
  owner          String?
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  repository     RecoveryRepository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([status])
}

model RecoveryRisk {
  id             String               @id @default(uuid())
  riskCode       String               @unique
  repositoryId   String
  title          String
  description    String
  severity       GovernanceSeverity
  status         GovernanceItemStatus @default(OPEN)
  mitigation     String?
  owner          String?
  acceptedBy     String?
  acceptedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  repository     RecoveryRepository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([status])
}

model RecoveryCertification {
  id                 String               @id @default(uuid())
  repositoryId       String
  certificationType  String
  decision           CertificationDecision @default(PENDING)
  reviewer           String?
  comments           String?
  decidedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  repository         RecoveryRepository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@index([certificationType])
}

model ExecutiveRecoveryApproval {
  id              String               @id @default(uuid())
  releaseVersion  String
  decision        CertificationDecision @default(PENDING)
  approver        String?
  comments        String?
  decidedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([releaseVersion])
  @@index([decision])
}

// ============================================================
// Production Deployment Lock (Batch 60)
// ============================================================

enum DeploymentLockDecision {
  GO
  NO_GO
}

enum DeploymentLockStatus {
  PENDING
  AUTHORIZED
  BLOCKED
  DEPLOYED
  REVOKED
}

model ProductionDeploymentLock {
  id                    String                @id @default(uuid())
  releaseVersion        String                @unique
  evidenceBundleId      String                @unique
  executiveDecision     DeploymentLockDecision
  authorizationSigned   Boolean               @default(false)
  authorizedBy          String?
  authorizationReference String?
  deploymentStatus      DeploymentLockStatus  @default(PENDING)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  authorizedAt          DateTime?
  deployedAt            DateTime?
  revokedAt             DateTime?
}
