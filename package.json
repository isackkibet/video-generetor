{
  "name": "yohpal-live-ai-content-factory",
  "version": "1.1.0",
  "private": true,
  "description": "YohPal Live AI Content Factory - seed video generation platform",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "cross-env NODE_ENV=test API_GATEWAY_KEY=test-api-key ADMIN_JWT_SECRET=test-secret jest --config jest.e2e.config.js --runInBand",
    "test:production-readiness": "cross-env NODE_ENV=test API_GATEWAY_KEY=test-api-key ADMIN_JWT_SECRET=test-secret jest tests/production-readiness --runInBand",
    "test:recovery-governance": "jest tests/recovery-governance --runInBand",
    "ci:evidence": "node scripts/generate-ci-evidence.js",
    "ci:production-readiness": "npm run typecheck && npm run test:production-readiness && npm run test:recovery-governance && npm run test:e2e && npm run ci:evidence",
    "certification:blueprint": "ts-node scripts/generate-blueprint-certification-report.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run test && npm run test:e2e",
    "certification:enforce": "ts-node scripts/enforce-blueprint-alignment.ts",
    "certification:go-no-go": "npm run certification:blueprint && npm run certification:enforce",
    "evidence:executive-bundle": "ts-node scripts/generate-executive-evidence-bundle.ts",
    "evidence:full": "npm run certification:blueprint && npm run certification:go-no-go && npm run ci:evidence && npm run evidence:executive-bundle",
    "deployment:verify-lock": "ts-node scripts/verify-production-deployment-lock.ts",
    "evidence:runtime": "ts-node scripts/generate-runtime-evidence.ts",
    "diagnostic:v4-closure": "ts-node scripts/generate-v4-closure-certification.ts",
    "launch:verify-events": "ts-node scripts/verify-event-processing.ts",
    "launch:verify-readiness": "ts-node scripts/verify-launch-readiness.ts",
    "finalize:ga": "ts-node scripts/finalize-general-availability.ts",
    "archive:artifacts": "ts-node scripts/archive-certification-artifacts.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
