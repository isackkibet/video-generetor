NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yohpal_live_ai"
REDIS_URL="redis://localhost:6379"
KAFKA_BROKERS="localhost:9092"

API_GATEWAY_PORT=3000
TREND_SERVICE_PORT=3001
SCRIPT_SERVICE_PORT=3002
RENDER_SERVICE_PORT=3003
MODERATION_SERVICE_PORT=3004
RECOMMENDATION_SERVICE_PORT=3005

# ✅ Added service URLs for API Gateway routing
TREND_SERVICE_URL="http://localhost:3001"
SCRIPT_SERVICE_URL="http://localhost:3002"
RENDER_SERVICE_URL="http://localhost:3003"
MODERATION_SERVICE_URL="http://localhost:3004"
RECOMMENDATION_SERVICE_URL="http://localhost:3005"

CDN_BASE_URL="https://cdn.yohpal.com"
OBJECT_STORAGE_BUCKET="yohpal-live-videos"
AI_GATEWAY_URL="http://localhost:8080"
TTS_PROVIDER="mock"
AVATAR_PROVIDER="mock"
VIDEO_RENDER_PROVIDER="mock"
MODERATION_THRESHOLD=0.78
VIRAL_PUBLISH_THRESHOLD=0.75

LLM_PROVIDER="mock"
MODERATION_PROVIDER="mock"
# Set these to yohpal_brain in production when YohPal Brain Gateway is ready.
# LLM_PROVIDER="yohpal_brain"
# TTS_PROVIDER="yohpal_brain"
# AVATAR_PROVIDER="yohpal_brain"
# VIDEO_RENDER_PROVIDER="yohpal_brain"
# MODERATION_PROVIDER="yohpal_brain"
AI_GATEWAY_URL="http://localhost:8080"

ALLOW_RENDER_FALLBACK=true
ALLOW_MODERATION_FALLBACK=true

For production, use stricter values:
# Production recommended:
# ALLOW_RENDER_FALLBACK=false
# ALLOW_MODERATION_FALLBACK=false

# LLM Provider Configuration
ALLOW_LLM_FALLBACK=true
LLM_PROVIDER="mock"

# Production recommended:
# ALLOW_LLM_FALLBACK=false
# LLM_PROVIDER="yohpal_brain"

# Admin Authentication
ADMIN_JWT_SECRET="change-this-secret"
ADMIN_SESSION_COOKIE="yohpal_admin_session"
API_GATEWAY_KEY="change-this-api-key"
SERVICE_AUTH_KEY="change-this-service-key"

ADMIN_TO_API_GATEWAY_KEY="change-this-api-key"